<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Decluttr.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@android:drawable/sym_def_app_icon</item>
        <item name="windowSplashScreenBackground">@color/CreamBackground</item>
        <item name="postSplashScreenTheme">@style/Theme.Decluttr</item>
    </style>

    <style name="Theme.Decluttr" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Default font: Manrope (bundled in res/font). Any view that does not
             explicitly set a TextAppearance still inherits this. -->
        <item name="android:fontFamily">@font/manrope</item>
        <item name="fontFamily">@font/manrope</item>

        <!-- Default text appearance per role -->
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Decluttr.DisplaySmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Decluttr.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Decluttr.TitleMedium</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Decluttr.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Decluttr.BodyMedium</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Decluttr.Label</item>

        <!-- Color roles -->
        <item name="colorPrimary">@color/Primary40</item>
        <item name="colorSecondary">@color/Secondary40</item>
        <item name="colorTertiary">@color/Tertiary40</item>
        <item name="android:colorBackground">@color/CreamBackground</item>
        <item name="colorSurface">@color/CreamSurface</item>
        <item name="colorSurfaceContainer">@color/CreamSurfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/CreamSurfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/CreamSurfaceContainerHighest</item>
    </style>

    <style name="Theme.Decluttr.Transparent" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <style name="ThemeOverlay.Decluttr.DashboardModal" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowAnimationStyle">@style/Animation.Decluttr.DashboardModal</item>
    </style>

    <style name="Animation.Decluttr.DashboardModal" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/archive_popup_enter</item>
        <item name="android:windowExitAnimation">@anim/archive_popup_exit</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/CreamBackground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Decluttr</item>
    </style>

    <!-- Legacy aliases — kept so existing layout refs compile. New code should
         use Shape.Decluttr.* from values/shape.xml. -->
    <style name="RoundedIconShape" parent="Shape.Decluttr.IconSquare" />
    <style name="CircleIconShape" parent="Shape.Decluttr.IconCircle" />
    <style name="SquircleIconShape" parent="Shape.Decluttr.IconSquircle" />
</resources>
