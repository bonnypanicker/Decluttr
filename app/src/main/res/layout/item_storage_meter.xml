<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/discovery_item_horizontal_margin"
    android:layout_marginBottom="@dimen/space_16"
    android:layout_marginTop="@dimen/space_8"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="@dimen/space_24"
    app:cardElevation="@dimen/elevation_none"
    app:strokeWidth="@dimen/elevation_none">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_storage_meter_card"
        android:padding="@dimen/space_20">

        <ImageView
            android:id="@+id/storage_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_storage_meter_icon"
            android:padding="@dimen/space_12"
            android:src="@drawable/ic_broom"
            app:tint="@android:color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/storage_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_16"
            android:text="@string/discovery_storage_estimated_label"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/storage_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/storage_icon"
            app:layout_constraintBottom_toTopOf="@id/storage_subtitle"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/storage_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_16"
            android:text="@string/discovery_storage_subtitle_empty"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@android:color/white"
            android:alpha="0.9"
            app:layout_constraintStart_toEndOf="@id/storage_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/storage_label"
            app:layout_constraintBottom_toBottomOf="@id/storage_icon" />

        <TextView
            android:id="@+id/storage_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:layout_marginEnd="@dimen/space_12"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="0 MB"
            android:textAppearance="?attr/textAppearanceDisplaySmall"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/waste_score"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/storage_icon" />

        <TextView
            android:id="@+id/waste_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_storage_meter_stat_chip_new"
            android:paddingHorizontal="@dimen/space_12"
            android:paddingVertical="@dimen/space_8"
            android:text="@string/discovery_storage_score_default"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/storage_value"
            app:layout_constraintStart_toEndOf="@id/storage_value"
            app:layout_constraintTop_toTopOf="@id/storage_value" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/storage_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            app:indicatorColor="@android:color/white"
            app:trackColor="@color/storage_meter_track"
            app:trackCornerRadius="@dimen/space_8"
            app:trackThickness="@dimen/space_12"
            android:max="100"
            android:progress="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/storage_value" />

        <TextView
            android:id="@+id/storage_motivation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="@string/discovery_storage_motivation_empty"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@android:color/white"
            android:alpha="0.9"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/storage_progress" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
