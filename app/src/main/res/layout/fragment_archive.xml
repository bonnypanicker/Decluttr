<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_16"
        android:layout_marginTop="@dimen/space_8"
        android:layout_marginBottom="@dimen/space_4"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <include
            android:id="@+id/archive_search_bar"
            layout="@layout/item_search_bar_inline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btn_view_switch"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/space_8"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Switch archive view"
            android:padding="@dimen/space_8"
            android:src="@drawable/ic_list"
            android:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/btn_reinstalled_apps"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/space_4"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="More archive actions"
            android:padding="@dimen/space_8"
            android:src="@drawable/ic_more_vert"
            android:tint="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/category_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/space_8"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <HorizontalScrollView
            android:id="@+id/category_scroll_view"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="@dimen/space_16"
            android:paddingEnd="@dimen/space_4"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chip_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <ImageButton
            android:id="@+id/btn_sort"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="@dimen/space_12"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Sort archived apps"
            android:padding="@dimen/space_8"
            android:src="@drawable/ic_sort"
            android:tint="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/archive_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="@dimen/space_16" />

        <View
            android:id="@+id/fast_scroll_thumb_archive"
            android:layout_width="24dp"
            android:layout_height="56dp"
            android:layout_gravity="end|top"
            android:layout_marginEnd="@dimen/space_2"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/empty_state_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/ic_archive_outlined"
                android:alpha="0.3"
                app:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/tv_empty_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/archive_empty_message"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_find_apps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:text="@string/archive_empty_action" />

            <FrameLayout
                android:id="@+id/btn_archive_login_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_archive_login"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:icon="@drawable/ic_google_logo"
                    android:text="@string/archive_empty_action_login" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/btn_archive_login_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorSize="@dimen/space_24"
                    app:trackThickness="@dimen/elevation_medium"
                    app:indicatorColor="?attr/colorOnPrimary"
                    app:trackColor="@android:color/transparent" />
            </FrameLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/tip_overlay_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="top"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingTop="@dimen/space_8"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tip_overlay_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
                app:cardCornerRadius="@dimen/space_20"
                app:cardElevation="@dimen/space_4"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="@dimen/elevation_low">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_16"
                    android:paddingVertical="@dimen/space_12">

                    <ImageView
                        android:id="@+id/iv_tip_overlay_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginTop="@dimen/space_2"
                        android:src="@drawable/ic_broom"
                        app:tint="?attr/colorPrimary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_tip_overlay_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Quick tip"
                            android:textAppearance="?attr/textAppearanceTitleSmall"
                            android:textColor="?attr/colorOnSurface"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_tip_overlay_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_2"
                            android:text=""
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btn_tip_overlay_close"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="@dimen/space_8"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Dismiss tip"
                        android:padding="@dimen/space_4"
                        android:src="@drawable/ic_close"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
